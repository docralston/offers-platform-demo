# Database (Supabase pooled + direct URLs)
DATABASE_URL="postgresql://user:pass@host:6543/db?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/db"
# Optional: separate demo Supabase project (used by vercel-env-bulk for offers-platform-demo)
DEMO_DATABASE_URL=
DEMO_DIRECT_URL=

# Clerk (invite-only in production)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=

# Access control (comma-separated emails)
ADMIN_EMAILS=you@example.com
ALLOWED_EMAILS=you@example.com

# LLM providers (production only — omit on demo when using BYOK)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_SKELETON=claude-haiku-4-5
ANTHROPIC_MODEL_LOCAL=claude-sonnet-4-6
ANTHROPIC_MODEL_FAQS=claude-sonnet-4-6
ANTHROPIC_MODEL_META=claude-sonnet-4-6
ANTHROPIC_MODEL_LINKS=claude-sonnet-4-6
ANTHROPIC_MODEL_FALLBACK=claude-haiku-4-5

# Toyota ingestion (GitHub Actions / local Playwright)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
TOYOTA_STORAGE_STATE_PATH=.playwright/toyota-storage.json
TOYOTA_USER_DATA_DIR=.playwright/toyota-session
TOYOTA_HEADLESS=1
PLAYWRIGHT_CHANNEL=chrome

# Model page configs (optional path override; demo auto-uses demo/modelpager-configs when DEMO_MODE=true)
MODELPAGER_CONFIGS=demo/modelpager-configs

# Asset CDN (production)
ASSETS_R2_BASE_URL=

# Demo deploy only
DEMO_MODE=false
DEMO_ASSET_BASE_URL=
NEXT_PUBLIC_DEMO_MODE=false
# Demo guest sign-in (DEMO_MODE only): one shared Clerk user + simple access code
DEMO_CLERK_USER_ID=
DEMO_ACCESS_CODE=demo
# BYOK: visitors use their own LLM key on /admin/model-pages (omit OPENAI/ANTHROPIC keys on demo)
DEMO_LLM_BYOK=false
NEXT_PUBLIC_DEMO_LLM_BYOK=false
DEMO_LLM_RATE_LIMIT=10
DEMO_LLM_RATE_WINDOW_MS=3600000

# Public embed API rate limit (per IP per minute)
PUBLIC_API_RATE_LIMIT=120
PUBLIC_API_RATE_WINDOW_MS=60000
